{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/planes/lint-planes/lint-planes.js --quiet"
          },
          {
            "type": "command",
            "command": "node .claude/conducta/establecer-conducta/establecer-conducta.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/conducta/establecer-conducta/establecer-conducta.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/conducta/establecer-conducta/establecer-conducta.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "amp@xelnagah-harness": true,
    "amp-memoria@xelnagah-harness": true,
    "amp-preferencias@xelnagah-harness": true,
    "amp-planes@xelnagah-harness": true,
    "amp-conocimiento@xelnagah-harness": true,
    "amp-semantica@xelnagah-harness": true,
    "amp-decisiones@xelnagah-harness": true,
    "amp-subsistemas@xelnagah-harness": true
  }
}
